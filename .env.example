# GEMINI_API_KEY: Required for Gemini forensic narrative explanations & multimodal image/video checks.
# Kept strictly server-side; never exposed to client bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Pretrained Audio Deepfake Classifier Configuration (Optional Server-Side Overrides) ---
# By default, TruthLens runs local ONNX Wav2Vec2 inference via @huggingface/transformers using
# ai8shiro/deepfake-audio-wav2vec2-ONNX (MIT license, 16 kHz mono, quantized q4).

# Option A: Custom dedicated audio anti-spoofing inference endpoint (e.g. FastAPI hosting garystafford/wav2vec2-deepfake-voice-detector)
# AUDIO_DETECTOR_API_URL="https://your-audio-detector-service.example.com/classify"
# AUDIO_DETECTOR_API_KEY=""

# Option B: Hugging Face Inference API (server-side token only; recommended for serverless deployments)
# HF_TOKEN=""
# AUDIO_DETECTOR_HF_MODEL="garystafford/wav2vec2-deepfake-voice-detector"

# Option C: Local ONNX Wav2Vec2 model override
# AUDIO_DETECTOR_LOCAL_MODEL="ai8shiro/deepfake-audio-wav2vec2-ONNX"
# AUDIO_DETECTOR_LOCAL_DTYPE="q4"
